{
  "android-continuous-integrity-gate": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/post_edit_tests.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "./hooks/stop_ktlint.sh",
        "timeout": 90
      }
    ]
  }
}
